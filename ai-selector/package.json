{
  "name": "@che-dashboard-plugins/ai-selector",
  "version": "1.0.0",
  "description": "AI tool selector plugin for Eclipse Che Dashboard",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "test": "jest --config ../jest.config.js --rootDir .. --testPathPattern=ai-selector",
    "lint:check": "eslint 'frontend/**/*.{ts,tsx}' 'backend/**/*.ts'",
    "lint:fix": "eslint --fix 'frontend/**/*.{ts,tsx}' 'backend/**/*.ts'",
    "format:check": "prettier --check '{frontend,backend}/**/*.{ts,tsx,css}'",
    "format:fix": "prettier --write '{frontend,backend}/**/*.{ts,tsx,css}'"
  },
  "peerDependencies": {
    "@eclipse-che/dashboard-plugins": "*",
    "react": "^18.0.0"
  }
}
